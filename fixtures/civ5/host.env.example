
# Civ V host environment (copy to My Games/.../civ5ai/host.env)
# Only the game HOST needs this file.

# GEMINI_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# Optional overrides written by Invoke-Civ5AiModSync.ps1 into Civ5Ai_Paths.lua:
# CIV5AI_PYTHON=C:\Users\you\miniconda3\python.exe
# CIV5AI_REPO=C:\Users\you\Documents\civ4ai
# CIV5AI_ROOT=C:\Users\you\Documents\My Games\Sid Meier's Civilization 5\civ5ai
# CIV5AI_SIDECAR_TIMEOUT=60

# Seat manifest (host.env for sync script):
# CIV5AI_MANAGED_SEATS=1,2,3,4,5
# CIV5AI_HUMAN_SEATS=0
# CIV5AI_AUTOTEST=0
# CIV5AI_ENABLE_SP_CHAT=1
