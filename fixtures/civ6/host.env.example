# Civ VI host environment (copy to My Games/.../civ6ai/host.env)
# Only the game HOST needs this file.

# GEMINI_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# Optional overrides written by Invoke-Civ6AiModSync.ps1 into Civ6Ai_Paths.lua:
# CIV6AI_PYTHON=C:\Users\you\miniconda3\python.exe
# CIV6AI_REPO=C:\Users\you\Documents\civ4ai
# CIV6AI_ROOT=C:\Users\you\Documents\My Games\Sid Meier's Civilization VI\civ6ai
# CIV6AI_SIDECAR_TIMEOUT=45

# Seat manifest (lobby GameConfiguration or host.env for sync script):
# CIV6AI_MANAGED_SEATS=1,2,3,4,5
# CIV6AI_HUMAN_SEATS=0
# CIV6AI_AUTOTEST=0
# CIV6AI_SEAT_EXPERIMENT=1
# CIV6AI_ENABLE_SP_CHAT=1
