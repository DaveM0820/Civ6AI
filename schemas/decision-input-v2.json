{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civ4ai.local/schema/decision-input-v2.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "decision", "personality", "game", "your_empire", "your_cities", "your_units", "known_players", "known_other_cities", "visible_other_units", "diplomacy", "known_map", "strategic_summary", "history", "advciv", "legal_commands"],
  "properties": {
    "schema_version": {"const": "civ4ai-input/2"},
    "decision": {"$ref": "#/$defs/decision"},
    "personality": {"$ref": "#/$defs/personality"},
    "game": {"$ref": "#/$defs/game"},
    "your_empire": {"$ref": "#/$defs/empire"},
