    "counteroffer": {"type": "object", "additionalProperties": false, "required": ["counteroffer_id", "our_items", "their_items"], "properties": {"counteroffer_id": {"$ref": "#/$defs/id"}, "our_items": {"type": "array", "items": {"$ref": "#/$defs/trade_item"}}, "their_items": {"type": "array", "items": {"$ref": "#/$defs/trade_item"}}}},
    "proposal": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "target_player_id", "proposal_index"], "properties": {"proposal_id": {"$ref": "#/$defs/id"}, "target_player_id": {"$ref": "#/$defs/id"}, "proposal_index": {"type": "integer", "minimum": 0}}},
    "chat_record": {"type": "object", "additionalProperties": false, "required": ["message_id", "from_player_id", "turn", "text"], "properties": {"message_id": {"$ref": "#/$defs/id"}, "from_player_id": {"$ref": "#/$defs/id"}, "turn": {"type": "integer", "minimum": 0}, "text": {"type": "string", "maxLength": 240}}},
    "known_map": {"type": "object", "additionalProperties": false, "required": ["format", "visibility_mode", "plots", "areas", "frontiers", "visible_stacks", "image"], "properties": {"format": {"const": "plot-grid-v1"}, "visibility_mode": {"enum": ["player_visible", "omniscient_debug"]}, "plots": {"type": "array", "items": {"$ref": "#/$defs/plot"}}, "areas": {"type": "array", "items": {"$ref": "#/$defs/area"}}, "frontiers": {"type": "array", "items": {"$ref": "#/$defs/frontier"}}, "visible_stacks": {"type": "array", "items": {"$ref": "#/$defs/stack"}}, "visibility_grid": {"type": "array", "items": {"type": "string"}}, "territory_owner_grid": {"type": "array", "items": {"type": "string"}}, "viewport": {"type": "object", "additionalProperties": false, "required": ["x0", "y0", "width", "height"], "properties": {"x0": {"type": "integer", "minimum": 0}, "y0": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}, "image": {"$ref": "#/$defs/image"}}},
    "river_edge": {"oneOf": [{"enum": ["N", "E", "S", "W"]}, {"type": "object", "additionalProperties": false, "required": ["dx", "dy"], "properties": {"dx": {"type": "integer"}, "dy": {"type": "integer"}, "edge_id": {"enum": ["E", "SE", "SW"]}}}]},
    "plot": {"type": "object", "additionalProperties": false, "required": ["plot_id", "x", "y", "knowledge", "last_seen_turn", "area_id", "terrain_id", "water", "hills", "peak", "fresh_water", "river_edges", "revealed_owner_id", "feature_id", "improvement_id", "route_id", "resource_id", "yields", "defense_percent", "city_id", "worked_by_city_id", "visible_stack_ids"], "properties": {"plot_id": {"$ref": "#/$defs/id"}, "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "knowledge": {"enum": ["visible", "remembered"]}, "last_seen_turn": {"type": ["integer", "null"], "minimum": 0}, "area_id": {"$ref": "#/$defs/id"}, "terrain_id": {"$ref": "#/$defs/id"}, "water": {"type": "boolean"}, "hills": {"type": "boolean"}, "peak": {"type": "boolean"}, "fresh_water": {"type": "boolean"}, "river_edges": {"type": "array", "items": {"$ref": "#/$defs/river_edge"}}, "revealed_owner_id": {"type": ["string", "null"]}, "feature_id": {"type": ["string", "null"]}, "improvement_id": {"type": ["string", "null"]}, "route_id": {"type": ["string", "null"]}, "resource_id": {"type": ["string", "null"]}, "yields": {"$ref": "#/$defs/yields"}, "defense_percent": {"type": "integer"}, "city_id": {"type": ["string", "null"]}, "worked_by_city_id": {"type": ["string", "null"]}, "visible_stack_ids": {"$ref": "#/$defs/id_array"}}},
