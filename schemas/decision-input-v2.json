    "your_units": {"type": "array", "items": {"$ref": "#/$defs/owned_unit"}},
    "known_players": {"type": "array", "items": {"$ref": "#/$defs/known_player"}},
    "known_other_cities": {"type": "array", "items": {"$ref": "#/$defs/known_city"}},
    "visible_other_units": {"type": "array", "items": {"$ref": "#/$defs/visible_unit"}},
    "diplomacy": {"$ref": "#/$defs/diplomacy"},
    "known_map": {"$ref": "#/$defs/known_map"},
    "strategic_summary": {"$ref": "#/$defs/summary"},
    "history": {"$ref": "#/$defs/history"},
    "advciv": {"$ref": "#/$defs/advciv"},
    "legal_commands": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/legal_command"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "id_array": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "amounts": {"type": "object", "additionalProperties": false, "required": ["current", "maximum", "change_per_turn"], "properties": {"current": {"type": "integer"}, "maximum": {"type": ["integer", "null"]}, "change_per_turn": {"type": "integer"}}},
    "yields": {"type": "object", "additionalProperties": false, "required": ["food", "production", "commerce"], "properties": {"food": {"type": "integer"}, "production": {"type": "integer"}, "commerce": {"type": "integer"}}},
    "commerce": {"type": "object", "additionalProperties": false, "required": ["gold", "research", "culture", "espionage"], "properties": {"gold": {"$ref": "#/$defs/commerce_item"}, "research": {"$ref": "#/$defs/commerce_item"}, "culture": {"$ref": "#/$defs/commerce_item"}, "espionage": {"$ref": "#/$defs/commerce_item"}}},
    "commerce_item": {"type": "object", "additionalProperties": false, "required": ["percent", "rate"], "properties": {"percent": {"type": "integer", "minimum": 0, "maximum": 100}, "rate": {"type": "integer"}, "stored": {"type": "integer"}, "next_policy_cost": {"type": "integer", "minimum": 0}, "free_policies": {"type": "integer", "minimum": 0}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["turn", "year", "phase", "player_id", "reason"], "properties": {"turn": {"type": "integer", "minimum": 0}, "year": {"type": "integer"}, "phase": {"const": "strategic_decision"}, "player_id": {"type": "string", "pattern": "^PLAYER_[0-9]+$"}, "reason": {"enum": ["turn_start", "diplomacy_request", "forced_recovery", "test"]}}},
    "personality": {"type": "object", "additionalProperties": false, "required": ["identity", "leader_id", "leader_name", "civilization_id"], "properties": {"identity": {"type": "string", "maxLength": 80}, "leader_id": {"$ref": "#/$defs/id"}, "leader_name": {"type": "string", "maxLength": 80}, "civilization_id": {"$ref": "#/$defs/id"}, "leader_traits": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 40}}}},
    "game": {"type": "object", "additionalProperties": false, "required": ["era_id", "start_era_id", "game_speed_id", "difficulty_id", "calendar_id", "map_script", "world_size_id", "climate_id", "sea_level_id", "map_width", "map_height", "wrap_x", "wrap_y", "max_turns", "options", "victory_ids", "network_multiplayer"], "properties": {"era_id": {"$ref": "#/$defs/id"}, "start_era_id": {"$ref": "#/$defs/id"}, "game_speed_id": {"$ref": "#/$defs/id"}, "difficulty_id": {"$ref": "#/$defs/id"}, "calendar_id": {"$ref": "#/$defs/id"}, "map_script": {"type": "string", "maxLength": 160}, "world_size_id": {"$ref": "#/$defs/id"}, "climate_id": {"$ref": "#/$defs/id"}, "sea_level_id": {"$ref": "#/$defs/id"}, "map_width": {"type": "integer", "minimum": 1}, "map_height": {"type": "integer", "minimum": 1}, "wrap_x": {"type": "boolean"}, "wrap_y": {"type": "boolean"}, "max_turns": {"type": ["integer", "null"], "minimum": 0}, "options": {"$ref": "#/$defs/id_array"}, "victory_ids": {"$ref": "#/$defs/id_array"}, "network_multiplayer": {"type": "boolean"}}},
    "research": {"type": "object", "additionalProperties": false, "required": ["tech_id", "progress", "cost", "research_per_turn", "estimated_turns_remaining", "queue", "known_tech_ids"], "properties": {"tech_id": {"type": ["string", "null"]}, "progress": {"type": "integer", "minimum": 0}, "cost": {"type": "integer", "minimum": 0}, "research_per_turn": {"type": "integer", "minimum": 0}, "estimated_turns_remaining": {"type": ["integer", "null"], "minimum": 0}, "queue": {"$ref": "#/$defs/id_array"}, "known_tech_ids": {"$ref": "#/$defs/id_array"}}},
    "empire": {"type": "object", "additionalProperties": false, "required": ["team_id", "score", "gold", "gold_per_turn", "commerce", "costs", "research", "civics", "religion", "resources", "unit_counts", "anarchy_turns", "golden_age_turns", "war_weariness", "victory_progress"], "properties": {"team_id": {"$ref": "#/$defs/id"}, "score": {"type": "integer"}, "gold": {"type": "integer"}, "gold_per_turn": {"type": "integer"}, "commerce": {"$ref": "#/$defs/commerce"}, "costs": {"$ref": "#/$defs/costs"}, "research": {"$ref": "#/$defs/research"}, "civics": {"type": "array", "items": {"$ref": "#/$defs/key_id"}}, "religion": {"$ref": "#/$defs/religion"}, "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}}, "unit_counts": {"$ref": "#/$defs/unit_counts"}, "anarchy_turns": {"type": "integer", "minimum": 0}, "golden_age_turns": {"type": "integer", "minimum": 0}, "war_weariness": {"type": "integer", "minimum": 0}, "victory_progress": {"type": "array", "items": {"$ref": "#/$defs/key_amount"}}}},
    "costs": {"type": "object", "additionalProperties": false, "required": ["unit_cost", "unit_supply", "city_maintenance", "civic_upkeep", "inflation"], "properties": {"unit_cost": {"type": "integer", "minimum": 0}, "unit_supply": {"type": "integer", "minimum": 0}, "city_maintenance": {"type": "integer", "minimum": 0}, "civic_upkeep": {"type": "integer", "minimum": 0}, "inflation": {"type": "integer", "minimum": 0}}},
    "key_id": {"type": "object", "additionalProperties": false, "required": ["key", "id"], "properties": {"key": {"$ref": "#/$defs/id"}, "id": {"$ref": "#/$defs/id"}}},
    "key_amount": {"type": "object", "additionalProperties": false, "required": ["id", "value"], "properties": {"id": {"$ref": "#/$defs/id"}, "value": {"type": "integer"}}},
    "religion": {"type": "object", "additionalProperties": false, "required": ["state_religion_id", "convertible_religion_ids", "conversion_timer"], "properties": {"state_religion_id": {"type": ["string", "null"]}, "convertible_religion_ids": {"$ref": "#/$defs/id_array"}, "conversion_timer": {"type": "integer", "minimum": 0}, "faith": {"type": "integer"}, "faith_per_turn": {"type": "integer"}, "has_pantheon": {"type": "boolean"}, "has_religion": {"type": "boolean"}}},
    "resource": {"type": "object", "additionalProperties": false, "required": ["resource_id", "available", "surplus", "imported", "exported"], "properties": {"resource_id": {"$ref": "#/$defs/id"}, "available": {"type": "integer", "minimum": 0}, "surplus": {"type": "integer"}, "imported": {"type": "integer", "minimum": 0}, "exported": {"type": "integer", "minimum": 0}}},
    "unit_counts": {"type": "object", "additionalProperties": false, "required": ["total", "workers", "settlers", "military", "missionaries", "spies", "great_people", "idle", "upgradeable"], "properties": {"total": {"type": "integer", "minimum": 0}, "workers": {"type": "integer", "minimum": 0}, "settlers": {"type": "integer", "minimum": 0}, "military": {"type": "integer", "minimum": 0}, "missionaries": {"type": "integer", "minimum": 0}, "spies": {"type": "integer", "minimum": 0}, "great_people": {"type": "integer", "minimum": 0}, "idle": {"type": "integer", "minimum": 0}, "upgradeable": {"type": "integer", "minimum": 0}}},
    "owned_city": {"type": "object", "additionalProperties": false, "required": ["city_id", "name", "plot_id", "area_id", "is_capital", "is_coastal", "population", "food", "production", "production_queue", "yields", "commerce", "happiness", "health", "maintenance", "culture", "great_people", "specialists", "buildings", "religions", "corporations", "trade_routes", "worked_plot_ids", "automation", "defense", "occupation_turns", "garrison_unit_ids"], "properties": {"city_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "maxLength": 128}, "plot_id": {"$ref": "#/$defs/id"}, "area_id": {"$ref": "#/$defs/id"}, "is_capital": {"type": "boolean"}, "is_coastal": {"type": "boolean"}, "population": {"type": "integer", "minimum": 1}, "food": {"$ref": "#/$defs/amounts"}, "production": {"$ref": "#/$defs/production"}, "production_queue": {"type": "array", "items": {"$ref": "#/$defs/queue_item"}}, "yields": {"$ref": "#/$defs/yields"}, "commerce": {"$ref": "#/$defs/commerce"}, "happiness": {"$ref": "#/$defs/rate_breakdown"}, "health": {"$ref": "#/$defs/rate_breakdown"}, "maintenance": {"type": "integer", "minimum": 0}, "culture": {"$ref": "#/$defs/amounts"}, "great_people": {"$ref": "#/$defs/amounts"}, "specialists": {"type": "array", "items": {"$ref": "#/$defs/specialist"}}, "buildings": {"$ref": "#/$defs/id_array"}, "religions": {"$ref": "#/$defs/id_array"}, "corporations": {"$ref": "#/$defs/id_array"}, "trade_routes": {"type": "array", "items": {"$ref": "#/$defs/trade_route"}}, "worked_plot_ids": {"$ref": "#/$defs/id_array"}, "automation": {"type": "object", "additionalProperties": false, "required": ["citizens", "production"], "properties": {"citizens": {"type": "boolean"}, "production": {"type": "boolean"}}}, "defense": {"type": "object", "additionalProperties": false, "required": ["percent", "bombard_damage"], "properties": {"percent": {"type": "integer"}, "bombard_damage": {"type": "integer", "minimum": 0}}}, "occupation_turns": {"type": "integer", "minimum": 0}, "garrison_unit_ids": {"$ref": "#/$defs/id_array"}}},
    "production": {"type": "object", "additionalProperties": false, "required": ["item_id", "progress", "cost", "production_per_turn", "estimated_turns_remaining"], "properties": {"item_id": {"type": ["string", "null"]}, "progress": {"type": "integer", "minimum": 0}, "cost": {"type": "integer", "minimum": 0}, "production_per_turn": {"type": "integer", "minimum": 0}, "estimated_turns_remaining": {"type": ["integer", "null"], "minimum": 0}}},
    "queue_item": {"type": "object", "additionalProperties": false, "required": ["order_index", "kind", "item_id", "progress", "cost"], "properties": {"order_index": {"type": "integer", "minimum": 0}, "kind": {"enum": ["unit", "building", "project", "process"]}, "item_id": {"$ref": "#/$defs/id"}, "progress": {"type": "integer", "minimum": 0}, "cost": {"type": "integer", "minimum": 0}}},
