    "diplomacy": {"type": "object", "additionalProperties": false, "required": ["relations", "active_deals", "pending_requests", "available_proposals", "legal_trade_inventory", "private_inbox"], "properties": {"relations": {"type": "array", "items": {"$ref": "#/$defs/diplo_relation"}}, "active_deals": {"type": "array", "items": {"$ref": "#/$defs/deal"}}, "pending_requests": {"type": "array", "items": {"$ref": "#/$defs/request"}}, "available_proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}}, "legal_trade_inventory": {"type": "array", "items": {"$ref": "#/$defs/trade_item"}}, "private_inbox": {"type": "array", "items": {"$ref": "#/$defs/chat_record"}}}},
    "diplo_relation": {"type": "object", "additionalProperties": false, "required": ["player_id", "relation"], "properties": {"player_id": {"$ref": "#/$defs/id"}, "relation": {"$ref": "#/$defs/relation"}}},
    "trade_item": {"type": "object", "additionalProperties": false, "required": ["trade_item_id", "kind", "data_id", "amount", "denial_id"], "properties": {"trade_item_id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/id"}, "data_id": {"type": ["string", "null"]}, "amount": {"type": ["integer", "null"]}, "denial_id": {"type": ["string", "null"]}}},
    "deal": {"type": "object", "additionalProperties": false, "required": ["deal_id", "other_player_id", "our_items", "their_items", "turns_active", "cancelable"], "properties": {"deal_id": {"$ref": "#/$defs/id"}, "other_player_id": {"$ref": "#/$defs/id"}, "our_items": {"type": "array", "items": {"$ref": "#/$defs/trade_item"}}, "their_items": {"type": "array", "items": {"$ref": "#/$defs/trade_item"}}, "turns_active": {"type": "integer", "minimum": 0}, "cancelable": {"type": "boolean"}}},
