    "specialist": {"type": "object", "additionalProperties": false, "required": ["specialist_id", "assigned", "free", "joined"], "properties": {"specialist_id": {"$ref": "#/$defs/id"}, "assigned": {"type": "integer", "minimum": 0}, "free": {"type": "integer", "minimum": 0}, "joined": {"type": "integer", "minimum": 0}}},
    "trade_route": {"type": "object", "additionalProperties": false, "required": ["partner_city_id", "owner_player_id", "commerce"], "properties": {"partner_city_id": {"$ref": "#/$defs/id"}, "owner_player_id": {"$ref": "#/$defs/id"}, "commerce": {"type": "integer", "minimum": 0}}},
    "owned_unit": {"type": "object", "additionalProperties": false, "required": ["unit_id", "unit_type_id", "unit_class_id", "domain_id", "plot_id", "health", "strength", "movement", "level", "experience", "promotion_ids", "activity_id", "mission_queue", "unit_ai_role", "cargo_unit_ids", "can_act", "needs_orders", "upgrade_options"], "properties": {"unit_id": {"$ref": "#/$defs/id"}, "unit_type_id": {"$ref": "#/$defs/id"}, "unit_class_id": {"$ref": "#/$defs/id"}, "domain_id": {"$ref": "#/$defs/id"}, "plot_id": {"$ref": "#/$defs/id"}, "health": {"$ref": "#/$defs/amounts"}, "strength": {"$ref": "#/$defs/amounts"}, "movement": {"$ref": "#/$defs/amounts"}, "level": {"type": "integer", "minimum": 1}, "experience": {"type": "integer", "minimum": 0}, "promotion_ids": {"$ref": "#/$defs/id_array"}, "activity_id": {"$ref": "#/$defs/id"}, "mission_queue": {"type": "array", "items": {"$ref": "#/$defs/mission"}}, "unit_ai_role": {"$ref": "#/$defs/id"}, "cargo_unit_ids": {"$ref": "#/$defs/id_array"}, "can_act": {"type": "boolean"}, "needs_orders": {"type": "boolean"}, "promotion_ready": {"type": "boolean"}, "range": {"type": "integer", "minimum": 0}, "upgrade_options": {"type": "array", "items": {"$ref": "#/$defs/upgrade"}}}},
    "mission": {"type": "object", "additionalProperties": false, "required": ["mission_id", "target_plot_id"], "properties": {"mission_id": {"$ref": "#/$defs/id"}, "target_plot_id": {"type": ["string", "null"]}}},
    "upgrade": {"type": "object", "additionalProperties": false, "required": ["unit_type_id", "gold_cost"], "properties": {"unit_type_id": {"$ref": "#/$defs/id"}, "gold_cost": {"type": "integer", "minimum": 0}}},
    "known_player": {"type": "object", "additionalProperties": false, "required": ["player_id", "team_id", "leader_id", "civilization_id", "score", "population", "land", "power", "known_capital_city_id", "known_religion_id", "known_civic_ids", "known_tech_ids", "relation"], "properties": {"player_id": {"$ref": "#/$defs/id"}, "team_id": {"$ref": "#/$defs/id"}, "leader_id": {"$ref": "#/$defs/id"}, "leader_name": {"type": "string", "maxLength": 80}, "civilization_id": {"$ref": "#/$defs/id"}, "score": {"type": ["integer", "null"]}, "population": {"type": ["integer", "null"]}, "land": {"type": ["integer", "null"]}, "power": {"type": ["integer", "null"]}, "known_capital_city_id": {"type": ["string", "null"]}, "known_religion_id": {"type": ["string", "null"]}, "known_civic_ids": {"$ref": "#/$defs/id_array"}, "known_tech_ids": {"$ref": "#/$defs/id_array"}, "relation": {"$ref": "#/$defs/relation"}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["met", "at_war", "open_borders", "defensive_pact", "vassal", "attitude_id", "attitude_value"], "properties": {"met": {"type": "boolean"}, "at_war": {"type": "boolean"}, "open_borders": {"type": "boolean"}, "defensive_pact": {"type": "boolean"}, "vassal": {"type": "boolean"}, "attitude_id": {"$ref": "#/$defs/id"}, "attitude_value": {"type": "integer"}}},
    "known_city": {"type": "object", "additionalProperties": false, "required": ["city_id", "owner_player_id", "name", "plot_id", "area_id", "knowledge", "last_seen_turn", "population", "is_capital", "visible_defense"], "properties": {"city_id": {"$ref": "#/$defs/id"}, "owner_player_id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "plot_id": {"$ref": "#/$defs/id"}, "area_id": {"$ref": "#/$defs/id"}, "knowledge": {"enum": ["visible", "remembered", "public"]}, "last_seen_turn": {"type": "integer", "minimum": 0}, "population": {"type": ["integer", "null"], "minimum": 1}, "is_capital": {"type": ["boolean", "null"]}, "visible_defense": {"type": ["integer", "null"]}}},
