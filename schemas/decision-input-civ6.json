{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civ4ai.local/schema/decision-input-civ6.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "personality",
    "game",
    "your_empire",
    "your_cities",
    "your_units",
    "known_players",
    "known_other_cities",
    "visible_other_units",
    "diplomacy",
    "known_map",
    "strategic_summary",
    "history",
    "advciv",
    "legal_commands",
    "civ6"
  ],
  "properties": {
    "schema_version": {"const": "civ6ai-input/1"},
    "decision": {"$ref": "decision-input-v2.json#/$defs/decision"},
    "personality": {"$ref": "decision-input-v2.json#/$defs/personality"},
    "game": {"$ref": "decision-input-v2.json#/$defs/game"},
    "your_empire": {"$ref": "decision-input-v2.json#/$defs/empire"},
    "your_cities": {"type": "array", "items": {"$ref": "decision-input-v2.json#/$defs/owned_city"}},
    "your_units": {"type": "array", "items": {"$ref": "decision-input-v2.json#/$defs/owned_unit"}},
    "known_players": {"type": "array", "items": {"$ref": "decision-input-v2.json#/$defs/known_player"}},
    "known_other_cities": {"type": "array", "items": {"$ref": "decision-input-v2.json#/$defs/known_city"}},
    "visible_other_units": {"type": "array", "items": {"$ref": "decision-input-v2.json#/$defs/visible_unit"}},
    "diplomacy": {"$ref": "decision-input-v2.json#/$defs/diplomacy"},
    "known_map": {"$ref": "decision-input-v2.json#/$defs/known_map"},
    "strategic_summary": {"$ref": "decision-input-v2.json#/$defs/summary"},
    "history": {"$ref": "decision-input-v2.json#/$defs/history"},
    "advciv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_unit_controller", "fallback_policy", "recommendations"],
      "properties": {
        "default_unit_controller": {"type": "string", "minLength": 1},
        "fallback_policy": {"type": "string", "minLength": 1},
        "recommendations": {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "decision-input-v2.json#/$defs/recommendation"}
        }
      }
    },
    "legal_commands": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "decision-input-v2.json#/$defs/legal_command"}
    },
    "civ6": {"$ref": "#/$defs/civ6_extension"}
  },
  "$defs": {
    "civ6_trade_stock": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "luxuries": {"type": "array", "items": {"$ref": "#/$defs/civ6_resource_amount"}},
        "strategics": {"type": "array", "items": {"$ref": "#/$defs/civ6_resource_amount"}},
        "gold": {"type": ["integer", "null"]},
        "gold_per_turn": {"type": ["integer", "null"]}
      }
    },
    "civ6_resource_amount": {
      "type": "object",
      "additionalProperties": true,
      "required": ["resource_id"],
      "properties": {
        "resource_id": {"type": "string"},
        "amount": {"type": "integer"}
      }
    },
    "civ6_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yields", "government_id", "map"],
      "properties": {
        "priorities": {
          "type": "array",
          "description": "Active Civ6Ai build priorities for this seat (level 1-3).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "level"],
            "properties": {
              "id": {"type": "integer", "minimum": 1},
              "level": {"type": "integer", "minimum": 1, "maximum": 3}
            }
          }
        },
        "yields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["science", "culture", "faith", "favor"],
          "properties": {
            "science": {"type": "integer"},
            "culture": {"type": "integer"},
            "faith": {"type": "integer"},
            "favor": {"type": "integer"}
          }
        },
        "government_id": {"$ref": "decision-input-v2.json#/$defs/id"},
        "session_id": {"type": "string"},
        "research_tech": {"type": ["string", "null"]},
        "experiment_city_id": {"type": ["string", "null"]},
        "experiment_build_id": {"type": ["string", "null"]},
        "research_civic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "civic_id": {"type": ["string", "null"]},
            "progress": {"type": "integer", "minimum": 0},
            "turns_left": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "governance": {
          "description": "Optional (older mods omit it). Government, policy cards, civics, religion, governors, great people and great works for this seat, read from the same engine calls as the game's screens.",
          "type": "object",
          "additionalProperties": true
        },
        "rankings": {
          "description": "Optional (older mods omit it). World Rankings screen data from the same engine calls as WorldRankings.lua: per alive major the science/culture/domination/religious/diplomatic stats, Game.GetVictoryProgressForTeam values, ruleset and enabled victories. Unmet players have met=false and no leader/civ identity.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "ruleset": {"type": "string"},
            "you": {"type": "string"},
            "players": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
          }
        },
        "combat": {
          "description": "Optional (older mods omit it). Combat awareness from the engine's CombatManager simulation: own unit strengths (units), visible hostile units/cities, attack previews (previews) and next-turn threats (threats).",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "units": {"type": "array", "items": {"type": "object"}},
            "hostiles": {"type": "array", "items": {"type": "object"}},
            "hostile_cities": {"type": "array", "items": {"type": "object"}},
            "previews": {"type": "array", "items": {"type": "object"}},
            "threats": {"type": "array", "items": {"type": "object"}}
          }
        },
        "economy": {
          "description": "Optional (older mods omit it). Civ5-parity economy panel from the engine: gold (treasury, gross income, maintenance by kind, net, UI tooltips), cities (yields, growth, housing, amenities/mood, build + turns, buildings, districts), happiness_levels (GameInfo.Happinesses), notifications, build_catalog/build_turns (production option stats), and the sidecar's tracking (idle streaks, notification turns).",
          "type": "object",
          "additionalProperties": true
        },
        "climate": {
          "description": "Optional Gathering Storm climate (GameClimate.*, ClimateScreen.lua). Omitted until CO2, temperature, or climate level is underway.",
          "type": "object",
          "additionalProperties": true
        },
        "power": {
          "description": "Optional Gathering Storm city power (city:GetPower, CityBannerManager.lua / CityPanelPower.lua). Omitted until a city requires or produces power.",
          "type": "object",
          "additionalProperties": true
        },
        "stockpiles": {
          "description": "Optional Gathering Storm strategic stockpiles (PlayerResources GetResourceAmount/Cap/Accumulation/Demand, TopPanel_Expansion2.lua). Omitted until a strategic has stock, income, or demand.",
          "type": "object",
          "additionalProperties": true
        },
        "diplomacy": {
          "description": "Optional (older mods omit it). Civ5-style relations: majors met with their diplomatic state toward you, relationship, wars (theirs too), attitude reasons and trade stock; city-states met with suzerain and your envoys; your own trade stock.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "majors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["player_id"],
                "properties": {
                  "player_id": {"type": "string"},
                  "state": {"type": ["string", "null"]},
                  "relationship": {"type": ["string", "null"]},
                  "diplomatic_score": {"type": ["integer", "null"]},
                  "at_war": {"type": "boolean"},
                  "can_declare_war": {"type": "boolean"},
                  "can_make_peace": {"type": "boolean"},
                  "denounced": {"type": "boolean"},
                  "declared_friendship": {"type": "boolean"},
                  "alliance": {"type": "boolean"},
                  "alliance_type": {"type": ["string", "null"]},
                  "open_borders": {"type": "boolean"},
                  "defensive_pact": {"type": "boolean"},
                  "at_war_with": {"type": "array", "items": {"type": "string"}},
                  "reasons": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
                  "trade": {"$ref": "#/$defs/civ6_trade_stock"}
                }
              }
            },
            "city_states": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["player_id"],
                "properties": {
                  "player_id": {"type": "string"},
                  "name": {"type": "string"},
                  "city_state_type": {"type": ["string", "null"]},
                  "suzerain_id": {"type": ["string", "null"]},
                  "your_envoys": {"type": ["integer", "null"]},
                  "at_war": {"type": "boolean"},
                  "can_declare_war": {"type": "boolean"},
                  "can_make_peace": {"type": "boolean"}
                }
              }
            },
            "wars": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
            "your_trade": {"$ref": "#/$defs/civ6_trade_stock"},
            "envoys_to_give": {"type": ["integer", "null"]}
          }
        },
        "city_extra": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "hex_layout": {"type": "string"},
            "coords_note": {"type": "string"}
          }
        }
      }
    }
  }
}
